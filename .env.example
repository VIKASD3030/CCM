# =============================================================================
# CCM Environment Variables
# =============================================================================
# Note: Nested configuration is supported using double underscores (__)
# Example: DATABASE__URL=postgresql+asyncpg://user:pass@localhost:5432/db

# -------------------------- Database --------------------------
# PostgreSQL connection URL (must be postgresql+asyncpg://)
DATABASE__URL=postgresql+asyncpg://ccm:ccm_password@localhost:5432/ccm_db
# Direct PostgreSQL URL (bypass PgBouncer) for LISTEN/NOTIFY support.
# Required when PgBouncer is in transaction pooling mode.
# Usually the same but connects directly to PostgreSQL port (5433) instead of PgBouncer (5432)
DATABASE_DIRECT_URL=postgresql://ccm:ccm_password@localhost:5433/ccm_db
# Connection pool settings
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=1800
DATABASE__POOL_PRE_PING=true

# -------------------------- Redis --------------------------
# Redis connection URL (for arq job queue)
REDIS__URL=redis://localhost:6379/0

# -------------------------- Storage --------------------------
# Storage backend: 'local' or 's3'
STORAGE__BACKEND=local
# Local storage path (used when STORAGE__BACKEND=local)
STORAGE__LOCAL_PATH=/tmp/ccm-files
# S3 settings (used when STORAGE__BACKEND=s3)
STORAGE__S3_BUCKET=ccm-files
STORAGE__S3_REGION=us-east-1
STORAGE__S3_ENDPOINT_URL=http://localhost:9000  # For MinIO
# AWS credentials (used when STORAGE__BACKEND=s3)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# -------------------------- AI --------------------------
# OpenAI API key
AI__OPENAI_API_KEY=sk-your-openai-api-key-here
# AI model settings
AI__MODEL=gpt-4o
AI__MAX_TOKENS=8192

# -------------------------- Auth --------------------------
# Secret key for JWT (must be at least 32 characters)
AUTH__SECRET_KEY=your-super-secret-key-change-this-to-at-least-32-characters
# Token expiration
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH__REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------- App --------------------------
APP_NAME=CCM - Correspondence Contract Management
DEBUG=false
ENVIRONMENT=development
# Allowed origins for CORS (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# Base URL for the application (used in email links and signed URLs)
APP_BASE_URL=http://localhost:8000

# -------------------------- File Upload --------------------------
MAX_UPLOAD_SIZE_MB=50
ENABLE_VIRUS_SCAN=false
CLAMAV_URL=http://localhost:8080  # Set if ENABLE_VIRUS_SCAN=true

# -------------------------- Webhooks --------------------------
# Secret key for HMAC signing of webhook payloads
WEBHOOK_SECRET_KEY=your-webhook-secret-key-change-this

# -------------------------- Rate Limiting --------------------------
# Default rate limit per minute for most endpoints
RATE_LIMIT_PER_MINUTE=100

# -------------------------- Prometheus --------------------------
ENABLE_METRICS=true
# Optional: CIDR range for restricting access to /api/metrics
# METRICS_ALLOWED_CIDR=10.0.0.0/8

# -------------------------- PgBouncer --------------------------
# Set to true if using PgBouncer (app connects to PgBouncer, not directly to Postgres)
USE_PGBOUNCER=true

# -------------------------- Email (SMTP) --------------------------
# SMTP settings for email notifications. Leave unset to disable email sending.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@ccm.app
SMTP_FROM_NAME=CCM System
